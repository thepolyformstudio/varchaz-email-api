# Varchaz Email Microservice Environment Variables
# Copy this file to .env for local testing, or add these to your Render environment variables.

# Your secret API key that the React app will send to authorize requests
API_KEY=your_super_secret_api_key_here

# SMTP Configuration (defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address (e.g., manager@company.com)
SMTP_USERNAME=your.email@gmail.com

# Your 16-character Gmail App Password (NOT your regular password)
SMTP_PASSWORD=your_16_char_app_password

# (Optional) The email address that appears in the "From" field. 
# Defaults to SMTP_USERNAME if left blank.
SENDER_EMAIL=your.email@gmail.com
